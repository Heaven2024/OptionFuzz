(set-option :strings-eager-solver false)
(set-option :strings-fmf true)
(set-option :strings-infer-as-lemmas true)
(set-logic QF_SLIA)
(declare-fun s1 () String)
(declare-fun s2 () String)
(declare-fun s3 () String)
(assert (= (str.++ s1 s2 s3) (str.++ s3 s2 s1)))
(assert (distinct s1 s2 s3))
(assert (str.in_re s1 (re.* (str.to_re "ab"))))
(assert (str.in_re s2 (re.* (str.to_re "cd"))))
(assert (str.in_re s3 (re.* (str.to_re "ef"))))
(assert (= (str.len s1) (str.len s2)))
(assert (= (str.len s2) (str.len s3)))
(assert (> (str.len s1) 0))
(check-sat)
(get-model)