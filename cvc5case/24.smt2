(set-option :strings-exp true)
(set-logic QF_SLIA)
(declare-fun s () String)
(declare-fun t () String)
(assert (str.in_re s (re.++ (re.* (str.to_re "a")) (re.* (str.to_re "b")))))
(assert (= (str.len s) 10))
(assert (= (str.len t) 10))
(assert (str.in_re t (re.++ (re.* (str.to_re "b")) (re.* (str.to_re "a")))))
(assert (not (= s t)))
(check-sat)
(get-model)