(set-option :strings-regexp-inclusion true)
(set-option :strings-eager-len-re true)
(set-option :re-inter-mode all)
(set-logic QF_SLIA)
(declare-fun s1 () String)
(declare-fun s2 () String)
(declare-fun s3 () String)
(assert (str.in_re s1 (re.inter (re.* (re.range "a" "m"))
                                (re.comp (re.* (re.range "n" "z"))))))
(assert (str.in_re s2 (re.inter (re.* (re.range "A" "M"))
                                (re.comp (re.* (re.range "N" "Z"))))))
(assert (= s3 (str.++ s1 s2)))
(assert (= (str.len s3) 20))
(assert (= (str.to_lower s2) s1))
(check-sat)
(get-model)