(set-option :strings-ff false)
(set-option :strings-len-norm false)
(set-option :re-inter-mode one-constant)
(set-logic QF_SLIA)
(declare-fun s1 () String)
(declare-fun s2 () String)
(declare-fun s3 () String)
(assert (str.in_re s1 (re.inter (re.* (str.to_re "ab")) 
                                (re.comp (re.* (str.to_re "ba"))))))
(assert (str.in_re s2 (re.diff (re.* (re.range "a" "z")) 
                               (re.* (str.to_re "cd")))))
(assert (= s3 (str.++ s1 s2)))
(assert (> (str.len s3) 10))
(check-sat)
(get-model)