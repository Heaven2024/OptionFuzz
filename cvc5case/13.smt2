(set-option :strings-alphabet "01")
(set-option :strings-regexp-inclusion true)
(set-logic QF_SLIA)
(declare-fun s () String)
(assert (str.in_re s (re.* (re.union (str.to_re "0") (str.to_re "1")))))
(assert (= (str.len s) 8))
(assert (str.prefixof "1" s))
(assert (str.suffixof "0" s))
(assert (> (str.to_int s) 100))
(check-sat)
(get-model)