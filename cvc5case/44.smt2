(set-option :strings-ff false)
(set-option :strings-infer-sym true)
(set-option :strings-eager-reg false)
(set-logic QF_SLIA)
(declare-fun s () String)
(declare-fun t () String)
(declare-fun i () Int)
(declare-fun j () Int)
(assert (> (str.len s) 20))
(assert (< (str.len s) 30))
(assert (>= i 0))
(assert (< i (str.len s)))
(assert (> j i))
(assert (< j (str.len s)))
(assert (= (str.substr s 0 i) (str.rev (str.substr s (- (str.len s) i) i))))
(assert (= (str.substr s i (- j i)) (str.rev (str.substr s i (- j i)))))
(assert (str.in_re (str.substr s j (- (str.len s) j)) (re.+ (re.range "0" "9"))))
(assert (= t (str.replace_re s (re.+ (re.range "0" "9")) (str.++ "NUM" (str.from_int (str.to_int (str.substr s j (- (str.len s) j))))))))
(check-sat)
(get-model)