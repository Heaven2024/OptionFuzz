(set-option :check-models true)
(set-option :finite-model-find true)
(set-logic UFDTLIA)
(declare-sort S 0)
(declare-fun f (S Int) S)
(declare-fun a () S)
(declare-fun b () S)
(assert (forall ((x S) (i Int))
  (=> (and (>= i 0) (< i 5))
      (not (= x (f x i))))))
(assert (exists ((j Int))
  (and (>= j 0) (< j 5) (= a (f b j)))))
(check-sat)
(get-model)