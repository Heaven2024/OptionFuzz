(set-option :produce-abducts true)
(set-logic QF_UFLIA)
(declare-fun f (Int) Int)
(declare-fun g (Int) Int)
(declare-fun x () Int)
(declare-fun y () Int)
(assert (> (f x) (g y)))
(assert (< (f y) (g x)))
(assert (= (+ x y) 10))
(check-sat)
(get-abduct A (exists ((z Int)) (and (> z 0) (= (f z) (g z)))))
