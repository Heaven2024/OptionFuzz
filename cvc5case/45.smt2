(set-option :bool-to-bv all)
(set-option :bv-to-bool true)
(set-option :bv-eq-engine false)
(set-logic QF_BV)
(declare-fun b1 () Bool)
(declare-fun b2 () Bool)
(declare-fun x () (_ BitVec 1))
(assert (= (ite b1 #b1 #b0) x))
(assert (= (bvnot x) (ite b2 #b1 #b0)))
(assert (distinct b1 b2))
(check-sat)
(get-model)