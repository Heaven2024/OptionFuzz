
(declare-fun a () (Array (_ BitVec 32) Real))
(declare-fun b () (Array Int (_ BitVec 32)))
(declare-fun c () (Array Real Int))
(declare-fun f ((_ BitVec 32) Int Real) Bool)
(declare-fun x () (_ BitVec 32))
(declare-fun y () Int)
(declare-fun z () Real)
(assert (= (select a x) (+ z (to_real y))))
(assert (= (select b y) (bvadd x (select b (+ y 1)))))
(assert (= (select c z) (- y (select c (- z 1.0)))))
(assert (f x y z))
(assert (not (f (select b y) (select c z) (select a x))))
(assert (= (bvmul x (select b y)) ((_ int2bv 32) (abs (select c z)))))
(assert (distinct x #x00000000 #xFFFFFFFF))
(assert (distinct y -1 0 1))
(assert (distinct z -1.0 0.0 1.0))
(check-sat)
(get-model)