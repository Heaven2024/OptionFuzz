(set-option :bv-solver bitblast)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(declare-fun y () (_ BitVec 64))
(assert (= (bvmul x y) (bvshl #x0000000000000001 #x000000000000003F)))
(assert (bvult x y))
(assert (bvugt x #x0000000000000001))
(assert (bvult y #xFFFFFFFFFFFFFFFF))
(check-sat)
(get-model)