(set-option :strings-eager-solver false)
(set-option :strings-fmf true)
(set-option :strings-infer-as-lemmas true)
(set-logic QF_SLIA)
(declare-fun s1 () String)
(declare-fun s2 () String)
(declare-fun s3 () String)
(assert (= (str.++ s1 s2) (str.++ s2 s1)))
(assert (not (= s1 s2)))
(assert (str.in_re s1 (re.* (str.to_re "ab"))))
(assert (str.in_re s2 (re.* (str.to_re "ba"))))
(assert (= s3 (str.replace_all (str.++ s1 s2) "ab" "BA")))
(assert (= (str.len s3) (* 2 (str.len s1))))
(check-sat)
(get-model)