(set-option :incremental true)
(set-option :produce-assertions true)
(set-logic QF_AUFBV)
(declare-fun a () (Array (_ BitVec 4) (_ BitVec 8)))
(declare-fun x () (_ BitVec 4))
(assert (= (select a x) #x42))
(check-sat)
(push 1)
(assert (= (bvadd x #x1) #x0))
(check-sat)
(pop 1)
(assert (= (select a #x0) #xff))
(check-sat)
(get-assertions)