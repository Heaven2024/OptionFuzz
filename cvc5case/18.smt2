(set-option :produce-abducts true)
(set-option :produce-interpolants true)
(set-logic QF_UFLIA)
(declare-fun f (Int) Int)
(declare-fun x () Int)
(declare-fun y () Int)
(assert (> (f x) y))
(assert (< (f y) x))
(assert (= (+ x y) 10))
(check-sat)
(get-abduct A (> x 0))
(get-interpolant ((> (f x) y)) ((< (f y) x) (= (+ x y) 10)))