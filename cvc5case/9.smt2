(set-option :random-seed 42)
(set-option :repeat-simp true)
(set-logic QF_AUFBVLIA)
(declare-fun a () (Array (_ BitVec 8) Int))
(declare-fun x () (_ BitVec 8))
(declare-fun y () Int)
(assert (= (select a x) y))
(assert (= (bvadd x #b00000001) ((_ int2bv 8) (+ y 1))))
(assert (> y 0))
(assert (< y 256))
(check-sat)
(get-model)