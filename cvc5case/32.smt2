(set-option :re-elim on)
(set-option :strings-infer-sym true)
(set-option :strings-rexplain-lemmas false)
(set-logic QF_SLIA)
(declare-fun s () String)
(declare-fun t () String)
(assert (str.in_re s (re.++ (re.* (str.to_re "a")) 
                            (re.+ (str.to_re "b")) 
                            (re.* (str.to_re "c")))))
(assert (= t (str.replace_all s "b" "d")))
(assert (= (str.indexof s "b" 0) (str.indexof t "d" 0)))
(assert (= (str.len s) (str.len t)))
(check-sat)
(get-model)