
(set-logic QF_SLIA)
(declare-fun s1 () String)
(declare-fun s2 () String)
(declare-fun s3 () String)
(assert (distinct s1 s2 s3))
(assert (= (str.len s1) (str.len s2)))
(assert (= (str.len s2) (str.len s3)))
(assert (str.contains s1 "abc"))
(assert (str.contains s2 "bca"))
(assert (str.contains s3 "cab"))
(assert (= (str.indexof s1 "abc" 0) (str.indexof s2 "bca" 0)))
(assert (= (str.indexof s2 "bca" 0) (str.indexof s3 "cab" 0)))
(assert (= (+ (str.to_int (str.at s1 0)) 
              (str.to_int (str.at s2 0)) 
              (str.to_int (str.at s3 0))) 
           (str.len s1)))
(check-sat)
(get-model)