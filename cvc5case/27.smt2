(set-option :strings-eager-eval false)
(set-option :strings-eager-len-re true)
(set-logic QF_SLIA)
(declare-fun s () String)
(assert (str.in_re s (re.++ (re.+ (str.to_re "a")) 
                            (re.+ (str.to_re "b")) 
                            (re.+ (str.to_re "c")))))
(assert (= (str.len s) (+ (str.indexof s "b" 0) (str.indexof s "c" 0))))
(check-sat)
(get-model)