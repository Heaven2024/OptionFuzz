(set-option :fp-exp true)
(set-option :produce-models true)
(set-logic QF_FPBV)
(declare-fun x () (_ FloatingPoint 8 24))
(declare-fun y () (_ FloatingPoint 8 24))
(assert (fp.leq x ((_ to_fp 8 24) RNE 1.0)))
(assert (fp.geq y ((_ to_fp 8 24) RNE -1.0)))
(assert (not (fp.isNaN (fp.add RNE x y))))
(assert (fp.lt (fp.mul RNE x y) ((_ to_fp 8 24) RNE 0.5)))
(check-sat)
(get-model)