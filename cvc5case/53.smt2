(set-option :bool-to-bv all)
(set-option :bv-to-bool true)
(set-option :bv-propagate true)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 1))
(declare-fun y () (_ BitVec 1))
(declare-fun z () (_ BitVec 1))
(assert (= (bvor x y) #b1))
(assert (= (bvand y z) #b0))
(assert (= (bvxor x z) y))
(check-sat)
(get-model)