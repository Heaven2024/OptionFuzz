(set-option :bv-assert-input true)
(set-option :bv-gauss-elim true)
(set-option :bv-intro-pow2 true)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 16))
(declare-fun y () (_ BitVec 16))
(declare-fun z () (_ BitVec 16))
(assert (= (bvadd x y z) #x8000))
(assert (= (bvmul x y) #x4000))
(assert (= (bvand y z) #x2000))
(assert (bvult x y))
(assert (bvult y z))
(check-sat)
(get-model)