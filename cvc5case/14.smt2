(set-option :bag-reduction true)
(set-option :uf-lazy-ll true)
(set-logic ALL)
(declare-sort Elem 0)
(declare-fun b1 () (Bag Elem))
(declare-fun b2 () (Bag Elem))
(declare-fun e () Elem)
(assert (= (bag.count e b1) 3))
(assert (= (bag.count e b2) 2))
(assert (= (bag.card (bag.union_max b1 b2)) 7))
(assert (not (= b1 b2)))
(check-sat)
(get-model)