(set-option :re-inter-mode constant)
(set-option :strings-regexp-inclusion true)
(set-logic QF_SLIA)
(declare-fun s () String)
(assert (str.in_re s (re.inter (re.* (re.range "0" "9")) 
                               (re.* (re.range "a" "z")))))
(assert (> (str.len s) 5))
(assert (< (str.len s) 10))
(check-sat)
(get-model)