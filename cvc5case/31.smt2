(set-option :strings-eager-eval false)
(set-option :strings-eager-len-re true)
(set-option :strings-regexp-inclusion true)
(set-logic QF_SLIA)
(declare-fun s () String)
(declare-fun t () String)
(assert (str.in_re s (re.++ (re.+ (re.range "A" "Z")) 
                            (re.+ (re.range "0" "9")) 
                            (re.+ (re.range "a" "z")))))
(assert (str.in_re t (re.++ (re.+ (re.range "a" "z")) 
                            (re.+ (re.range "0" "9")) 
                            (re.+ (re.range "A" "Z")))))
(assert (= (str.len s) (str.len t)))
(assert (str.contains s t))
(check-sat)
(get-model)