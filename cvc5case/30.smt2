(set-option :seq-array eager)
(set-option :strings-alpha-card 256)
(set-option :strings-check-entail-len true)
(set-logic QF_SLIA)
(declare-fun s () String)
(declare-fun i () Int)
(declare-fun j () Int)
(assert (= (str.len s) 20))
(assert (< i j))
(assert (>= i 0))
(assert (< j 20))
(assert (= (str.substr s 0 i) (str.substr s (- 20 i) i)))
(assert (= (str.substr s i (- j i)) (str.rev (str.substr s i (- j i)))))
(check-sat)
(get-model)