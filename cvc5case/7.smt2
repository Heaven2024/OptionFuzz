(set-option :sets-ext true)
(set-option :produce-models true)
(set-logic ALL)
(declare-sort Elem 0)
(declare-fun S () (Set Elem))
(declare-fun T () (Set Elem))
(declare-fun e () Elem)
(assert (set.member e S))
(assert (not (set.member e T)))
(assert (= (set.card (set.union S T)) 5))
(check-sat)
(get-model)