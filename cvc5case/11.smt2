(set-option :global-declarations true)
(set-option :dt-rewrite-error-sel true)
(set-logic UFDTLIA)
(declare-datatypes ((Tree 0)) (((leaf (value Int)) (node (left Tree) (right Tree)))))
(declare-fun t () Tree)
(declare-fun sum (Tree) Int)
(assert (= (sum t) 10))
(assert (forall ((x Tree))
  (= (sum x)
     (ite (is-leaf x)
          (value x)
          (+ (sum (left x)) (sum (right x)))))))
(assert (not (is-leaf t)))
(check-sat)
(get-model)