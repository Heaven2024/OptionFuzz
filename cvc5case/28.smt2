(set-option :re-elim agg)
(set-option :strings-rexplain-lemmas false)
(set-logic QF_SLIA)
(declare-fun s () String)
(assert (str.in_re s (re.++ (re.* (re.range "A" "Z")) 
                            (re.+ (re.range "0" "9")) 
                            (re.* (re.range "a" "z")))))
(assert (= (str.len s) 10))
(assert (= (str.to_int (str.substr s 3 3)) 42))
(check-sat)
(get-model)