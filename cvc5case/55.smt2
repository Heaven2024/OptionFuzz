(set-option :bitblast eager)
(set-option :bv-sat-solver cadical)
(set-option :bv-intro-pow2 true)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(declare-fun z () (_ BitVec 32))
(assert (= (bvmul x y) (bvshl #x00000001 z)))
(assert (bvult z #x00000020))
(assert (bvugt (bvadd x y) #x7FFFFFFF))
(assert (= (bvand x y) (bvor x y)))
(check-sat)
(get-model)