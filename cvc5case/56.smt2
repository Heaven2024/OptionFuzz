
(set-logic UFLIA)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun h (Int) Bool)
(declare-fun p (Int Int) Bool)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (= (f x) (g y z)))
(assert (h x))
(assert (p y z))
(assert (not (h z)))
(assert (= (+ (f x) (f y) (f z)) 100))
(assert (> (g x y) (g y z)))
(assert (distinct x y z))
(check-sat)
(get-model)