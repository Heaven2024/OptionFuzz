(set-option :bv-assert-input true)
(set-option :bv-eager-eval true)
(set-option :bv-gauss-elim true)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(declare-fun y () (_ BitVec 8))
(declare-fun z () (_ BitVec 8))
(assert (= (bvadd x y) #xFF))
(assert (= (bvmul y z) #x01))
(assert (bvugt x z))
(check-sat)
(get-model)