(set-option :bitblast lazy)
(set-option :bv-solver bitblast-internal)
(set-option :produce-proofs true)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(assert (= (bvadd x y) #x00000000))
(assert (bvult x y))
(assert (not (= x #xFFFFFFFF)))
(check-sat)
(get-proof)