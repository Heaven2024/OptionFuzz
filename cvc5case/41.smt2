(set-option :strings-exp true)
(set-option :re-elim agg)
(set-option :strings-fmf true)
(set-logic QF_SLIA)
(declare-fun s () String)
(declare-fun t () String)
(declare-fun i () Int)
(assert (str.in_re s (re.++ (re.* (re.union (str.to_re "a") (str.to_re "b")))
                            (re.+ (re.range "0" "9"))
                            (re.* (re.union (str.to_re "x") (str.to_re "y"))))))

(assert (= i (str.to_int (str.substr s (str.indexof s "0" 0) 
                                       (- (str.indexof s "x" 0) (str.indexof s "0" 0))))))
(assert (= (str.len t) (+ (str.len s) 2)))
(check-sat)
(get-model)