(set-option :sat.local_search_threads 1)
(set-option :sat.local_search true)
(set-option :sat.ddfw.reinit_base 12000)
(set-option :sat.ddfw.use_reward_pct 20)
(set-logic QF_BV)
(declare-fun a () (_ BitVec 64))
(declare-fun b () (_ BitVec 64))
(assert (bvult (bvadd a b) #xFFFFFFFFFFFFFFFF))
(assert (bvugt (bvmul a b) #x0000000000000001))
(check-sat)