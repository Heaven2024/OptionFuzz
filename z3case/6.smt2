(set-logic QF_AUFBV)
(set-option :produce-models true)
(set-option :bv-div-zero-const true)
(set-option :bv-eq-slicer 2)
(declare-fun a () (Array (_ BitVec 8) (_ BitVec 32)))
(declare-fun x () (_ BitVec 8))
(declare-fun y () (_ BitVec 32))
(assert (= (select a (bvudiv x (bvnot #x00))) y))
(assert (= (bvand y #x0000FFFF) (bvor (select a x) #x0000FFFF)))
(check-sat)
(get-model)