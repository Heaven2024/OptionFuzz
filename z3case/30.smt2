(set-option :sat.gc psm)
(set-option :sat.gc.burst true)
(set-option :sat.gc.defrag false)
(set-option :sat.gc.initial 25000)
(set-option :sat.inprocess.max 10)
(set-logic QF_BV)
(declare-fun p () (_ BitVec 16))
(declare-fun q () (_ BitVec 16))
(assert (bvule p q))
(assert (bvuge (bvadd p #x0001) q))
(assert (= (bvxor p q) #xFFFF))
(check-sat)
(get-model)