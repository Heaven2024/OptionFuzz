(set-logic QF_NRA)
(set-option :nlsat.check_lemmas false)
(set-option :nlsat.inline_vars true)
(set-option :nlsat.factor true)
(set-option :nlsat.lazy 3)
(set-option :nlsat.randomize true)

(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun z () Real)
(assert (and (> (* x x) (* y z)) (< (+ y y) z)))
(assert (= (sin x) (+ y z)))
(assert (or (>= (exp y) (log z)) (<= x y)))
(check-sat)