(set-option :sat.ate false)
(set-option :sat.ddfw_search true)
(set-option :sat.local_search_threads 3)
(set-option :sat.random_seed 12345)
(set-option :sat.scc.tr true)
(set-logic QF_ALIA)
(declare-fun a () (Array Int Int))
(declare-fun b () (Array Int Int))
(declare-fun i () Int)
(assert (= (select a i) (select b i)))
(assert (> i 0))
(assert (< (select a (- i 1)) (select b (+ i 1))))
(check-sat)