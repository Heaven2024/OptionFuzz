(set-option :sat.cut.xor true)
(set-option :sat.ddfw.reinit_base 15000)
(set-option :sat.gc.burst false)
(set-option :sat.lookahead.use_learned true)
(set-option :sat.search.sat.conflicts 500)
(set-logic QF_AUFBV)
(declare-fun a () (Array (_ BitVec 8) (_ BitVec 16)))
(declare-fun x () (_ BitVec 8))
(declare-fun y () (_ BitVec 16))
(assert (= (select a x) y))
(assert (bvult x #xA0))
(assert (bvugt y #x1000))
(check-sat)