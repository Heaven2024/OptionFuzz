(set-option :sat.lookahead.delta_fraction 0.87)
(set-option :sat.lookahead.preselect false)
(set-option :sat.lookahead.simplify.bca false)
(set-option :sat.resolution.limit 600000)
(set-logic QF_LRA)
(declare-fun x () Real)
(declare-fun y () Real)
(assert (>= (+ (* 2 x) y) 1.5))
(assert (<= (- x y) 0.7))
(check-sat)