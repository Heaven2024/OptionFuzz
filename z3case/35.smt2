(set-option :sat.anf true)
(set-option :sat.bce true)
(set-option :sat.cardinality.solver false)
(set-option :sat.phase random)
(set-option :sat.retain_blocked_clauses false)
(set-logic QF_FP)
(declare-fun x () (_ FloatingPoint 8 24))
(declare-fun y () (_ FloatingPoint 8 24))
(assert (fp.gt x ((_ to_fp 8 24) RNE 0.0)))
(assert (fp.lt y ((_ to_fp 8 24) RNE 1.0)))
(assert (fp.eq (fp.add RNE x y) ((_ to_fp 8 24) RNE 1.0)))
(check-sat)
(get-model)