(set-logic QF_BV)
(set-option :produce-models true)
(set-option :incremental true)
(set-option :bv-intro-pow2 true)
(set-option :bv-gaussian true)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(push 1)
(assert (bvult x y))
(check-sat)
(pop 1)
(push 1)
(assert (bvugt x y))
(check-sat)
(get-model)