(set-option :sat.asymm_branch.all true)
(set-option :sat.branching.heuristic chb)
(set-option :sat.cut.force true)
(set-option :sat.lookahead.use_learned true)
(set-option :sat.restart.max 1000000)
(set-logic QF_ALIA)
(declare-fun a () (Array Int Int))
(declare-fun b () (Array Int Int))
(declare-fun i () Int)
(declare-fun j () Int)
(assert (= (select a i) (select b j)))
(assert (not (= i j)))
(assert (> (select a j) (select b i)))
(check-sat)
(get-model)