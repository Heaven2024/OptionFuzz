(set-option :sls.early_prune false)
(set-option :sls.max_restarts 5000)
(set-option :sls.paws_init 60)
(set-option :sls.paws_sp 100)
(set-option :sls.random_offset true)
(set-option :sls.rescore true)
(set-option :sls.scale_unsat 0.7)
(set-option :sls.wp 200)
(set-option :sls.walksat_ucb_forget 0.95)
(set-logic QF_BV)
(declare-fun a () (_ BitVec 64))
(declare-fun b () (_ BitVec 64))
(declare-fun c () (_ BitVec 64))
(assert (= (bvor a b) c))
(assert (bvult a #x1000000000000000))
(assert (bvugt b #x0FFFFFFFFFFFFFFF))
(assert (bvule c #xFFFFFFFFFFFFFFFF))
(check-sat)
(get-model)