(set-logic HORN)
(set-option :fp.engine spacer)
(set-option :fp.spacer.global true)
(set-option :fp.spacer.eq_prop true)
(set-option :fp.spacer.validate_lemmas true)
(set-option :fp.datalog.all_or_nothing_deltas true)

(declare-rel P (Int))
(declare-rel Q (Int))
(declare-rel R (Int))
(declare-rel S (Int Int))
(declare-var x Int)
(declare-var y Int)

(rule (=> (and (P x) (< x 10)) (Q (+ x 1))))
(rule (=> (Q x) (R x)))
(rule (=> (and (S x y) (< y 5)) (P y)))
(rule (=> (R x) (S x (+ x 2))))
(query R :print-answer true)