(set-option :sat.cce true)
(set-option :sat.lookahead.cube.psat.var_exp 1.2)
(set-option :sat.override_incremental true)
(set-option :sat.resolution.occ_cutoff 12)
(set-option :sat.search.unsat.conflicts 500)
(set-logic QF_S)
(declare-fun x () String)
(declare-fun y () String)
(assert (= (str.++ x y) "hello world"))
(assert (> (str.len x) (str.len y)))
(assert (str.contains y "o"))
(check-sat)
(get-model)