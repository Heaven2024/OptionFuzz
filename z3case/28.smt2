(set-option :sat.branching.heuristic vsids)
(set-option :sat.phase caching)
(set-option :sat.restart ema)
(set-option :sat.restart.emafastglue 0.02)
(set-option :sat.variable_decay 105)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(declare-fun y () (_ BitVec 64))
(assert (bvult x y))
(assert (= (bvand x y) (bvor x y)))
(assert (bvugt (bvadd x #x0000000000000001) y))
(check-sat)
(get-model)