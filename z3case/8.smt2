(set-logic QF_BV)
(set-option :produce-models true)
(set-option :bv-sat-solver cadical)
(set-option :bv-intro-pow2 true)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 16))
(assert (= (concat ((_ extract 15 0) x) y) (bvnot x)))
(assert (= (bvand x (concat y y)) (bvor x (concat #x0000 y))))
(check-sat)
(get-model)