(set-option :sat.lookahead_simplify true)
(set-option :sat.pb.resolve rounding)
(set-option :sat.prob_search true)
(set-option :sat.probing_cache false)
(set-option :sat.resolution.lit_cutoff_range2 450)
(set-logic QF_RDL)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun z () Real)
(assert (<= (- x y) 1.5))
(assert (<= (- y z) 2.5))
(assert (>= (- x z) 4.5))
(check-sat)
(get-model)