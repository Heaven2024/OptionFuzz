(set-option :sat.scc true)
(set-option :sat.scc.tr false)
(set-option :sat.simplify.delay 100)
(set-option :sat.subsumption.limit 150000000)
(set-option :sat.variable_decay 115)
(set-logic QF_NIA)
(declare-fun x () Int)
(declare-fun y () Int)
(assert (= (* x x) (+ (* y y) 1)))
(assert (>= x 0))
(assert (>= y 0))
(check-sat)
(get-model)