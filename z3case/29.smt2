(set-option :sat.asymm_branch true)
(set-option :sat.asymm_branch.sampled false)
(set-option :sat.backtrack.conflicts 5000)
(set-option :sat.cardinality.solver false)
(set-option :sat.elim_vars true)
(set-logic QF_BV)
(declare-fun a () (_ BitVec 32))
(declare-fun b () (_ BitVec 32))
(declare-fun c () (_ BitVec 32))
(assert (= (bvmul a b) c))
(assert (bvugt a #x00000100))
(assert (bvult b #xFFFFFF00))
(assert (bvsgt c #x00000000))
(check-sat)
(get-model)