(set-option :sat.anf.exlin true)
(set-option :sat.bce true)
(set-option :sat.elim_vars false)
(set-option :sat.minimize_lemmas true)
(set-option :sat.resolution.occ_cutoff_range2 6)
(set-logic QF_BVFP)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ FloatingPoint 8 24))
(assert (fp.gt ((_ to_fp 8 24) RNE x) y))
(assert (bvult x #x7FFFFFFF))
(assert (fp.isNormal y))
(check-sat)