(set-option :sls.random_seed 9876)
(set-option :sls.vns_repick true)
(set-option :sls.walksat false)
(set-option :sls.wp 200)
(set-logic QF_BV)
(declare-fun u () (_ BitVec 16))
(declare-fun v () (_ BitVec 16))
(declare-fun w () (_ BitVec 16))
(declare-fun x () (_ BitVec 16))
(declare-fun y () (_ BitVec 16))
(assert (= (bvadd (bvmul u v) (bvmul w x)) y))
(assert (bvult (bvshl u 2) (bvlshr v 1)))
(assert (bvsgt (bvashr w 3) (bvrotate_left x 5)))
(assert (= (bvxor (bvand u w) (bvor v x)) y))
(assert (bvule (bvnot u) (bvneg v)))
(assert (= (bvcomp w x) #b1))
(check-sat)
(get-model)