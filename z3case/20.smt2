(set-option :sls.walksat true)
(set-option :sls.walksat_repick true)
(set-option :sls.walksat_ucb true)
(set-option :sls.walksat_ucb_constant 15.5)
(set-option :sls.walksat_ucb_noise 0.0005)
(set-logic QF_BV)
(declare-fun a () (_ BitVec 16))
(declare-fun b () (_ BitVec 16))
(assert (= (bvadd a b) #xFFFF))
(assert (bvult a b))
(check-sat)
(get-model)