(set-option :sat.lookahead.reward heule_schur)
(set-option :sat.lookahead.double false)
(set-option :sat.lookahead.use_learned false)
(set-option :sat.elim_vars_bdd true)
(set-logic QF_BV)
(declare-fun a () (_ BitVec 64))
(declare-fun b () (_ BitVec 64))
(assert (bvult (bvadd a b) #xFFFFFFFFFFFFFFFF))
(assert (bvugt (bvmul a b) #x0000000000000001))
(check-sat)