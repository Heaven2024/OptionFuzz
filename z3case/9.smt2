(set-logic AUFLIA)
(set-option :produce-models true)
(set-option :arrays-exp true)
(declare-fun a () (Array Int (Array Int Int)))
(declare-fun i () Int)
(declare-fun j () Int)
(assert (= (select (select a i) j) (+ i j)))
(assert (forall ((x Int) (y Int))
  (=> (and (>= x 0) (< x 10) (>= y 0) (< y 10))
      (>= (select (select a x) y) 0))))
(assert (exists ((k Int))
  (and (>= k 0) (< k 10) (= (select (select a k) k) 0))))
(check-sat)
(get-model)