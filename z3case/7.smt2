(set-option :produce-models true)

(declare-datatypes ((Tree 0) (List 0)) (
  ((leaf (value Int)) (node (left Tree) (right Tree)))
  ((nil) (cons (head Tree) (tail List)))
))
(declare-fun tree_sum (Tree) Int)
(declare-fun list_sum (List) Int)
(assert (= (tree_sum (leaf 5)) 5))
(assert (forall ((l Tree) (r Tree))
  (= (tree_sum (node l r)) (+ (tree_sum l) (tree_sum r)))))
(assert (= (list_sum nil) 0))
(assert (forall ((h Tree) (t List))
  (= (list_sum (cons h t)) (+ (tree_sum h) (list_sum t)))))
(declare-fun t () Tree)
(declare-fun l () List)
(assert (= t (node (leaf 3) (leaf 4))))
(assert (= l (cons t (cons (leaf 5) nil))))
(assert (= (list_sum l) 12))
(check-sat)
(get-model)