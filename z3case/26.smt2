(set-option :sls.random_offset true)
(set-option :sls.restart_base 150)
(set-option :sls.walksat_ucb_forget 0.98)
(set-option :sls.walksat_ucb_noise 0.0001)
(set-logic QF_BV)
(declare-fun p () (_ BitVec 32))
(declare-fun q () (_ BitVec 32))
(declare-fun r () (_ BitVec 32))
(declare-fun s () (_ BitVec 32))
(assert (= (bvor (bvand p q) (bvand r s)) (bvxor (bvor p r) (bvor q s))))
(assert (bvult (bvadd p q) (bvmul r s)))
(assert (= (bvshl p 3) (bvlshr q 2)))
(assert (bvsgt (bvsdiv p q) (bvsmod r s)))
(assert (= (bvrotate_right p 5) (bvrotate_left q 27)))
(check-sat)
(get-model)