(set-option :sat.backtrack.scopes 150)
(set-option :sat.cardinality.solver false)
(set-option :sat.gc.k 8)
(set-option :sat.phase.sticky false)
(set-option :sat.probing_binary false)
(set-logic QF_UFNRA)
(declare-fun f (Real) Real)
(declare-fun x () Real)
(declare-fun y () Real)
(assert (> (f x) (+ y 1.0)))
(assert (< (f y) (- x 0.5)))
(assert (= (+ (f x) (f y)) 2.0))
(check-sat)