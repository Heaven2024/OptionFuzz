(set-option :sat.anf.exlin true)
(set-option :sat.binspr true)
(set-option :sat.core.minimize true)
(set-option :sat.ddfw.init_clause_weight 10)
(set-option :sat.local_search_dbg_flips true)
(set-logic QF_UFNRA)
(declare-fun f (Real) Real)
(declare-fun x () Real)
(declare-fun y () Real)
(assert (> (f x) y))
(assert (< (f y) x))
(assert (= (+ x y) 1.0))
(check-sat)
(get-model)