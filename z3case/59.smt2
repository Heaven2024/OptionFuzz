(set-option :sat.anf.delay 3)
(set-option :sat.binspr true)
(set-option :sat.burst_search 150)
(set-option :sat.elim_vars_bdd_delay 4)
(set-option :sat.gc psm)
(set-logic QF_FPBV)
(declare-fun f () (_ FloatingPoint 11 53))
(declare-fun b () (_ BitVec 64))
(assert (fp.isNormal f))
(assert (bvult b (fp.to_ubv RNE f 64)))
(check-sat)