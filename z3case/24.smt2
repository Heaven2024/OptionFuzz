(set-option :sls.random_seed 42)
(set-option :sls.max_restarts 5000)
(set-option :sls.walksat_ucb true)
(set-option :sls.vns_mc 2)
(set-option :sls.wp 150)
(set-logic QF_BV)
(declare-fun a () (_ BitVec 128))
(declare-fun b () (_ BitVec 128))
(declare-fun c () (_ BitVec 128))
(assert (= (bvand a b) (bvor b c)))
(assert (bvult (bvadd a c) (bvmul b (bvshl c #x0000000000000000000000000000001))))
(assert (= (bvxor a c) (bvrotate_left b 7)))
(assert (bvsgt (bvsdiv a b) (bvsrem c a)))
(assert (bvule (bvnot a) (bvneg b)))
(assert (= (bvcomp a b) #b1))
(check-sat)
(get-model)