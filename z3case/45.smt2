(set-option :sat.cardinality.encoding unate)
(set-option :sat.dyn_sub_res false)
(set-option :sat.gc.increment 600)
(set-option :sat.lookahead.cube.psat.trigger 4.5)
(set-option :sat.restart.margin 1.2)
(set-logic QF_UFNIA)
(declare-fun f (Int) Int)
(declare-fun x () Int)
(declare-fun y () Int)
(assert (> (f x) (* 2 y)))
(assert (< (f y) (- x 5)))
(assert (= (+ (f x) (f y)) 10))
(check-sat)
(get-model)