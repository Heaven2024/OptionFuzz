(set-option :sat.burst_search 200)
(set-option :sat.elim_vars_bdd true)
(set-option :sat.gc.k 5)
(set-option :sat.minimize_lemmas false)
(set-option :sat.subsumption true)
(set-logic QF_UF)
(declare-sort S 0)
(declare-fun f (S) S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(assert (= (f a) b))
(assert (= (f b) c))
(assert (not (= (f a) c)))
(check-sat)