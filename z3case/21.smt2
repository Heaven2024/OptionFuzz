(set-option :sls.restart_base 200)
(set-option :sls.restart_init true)
(set-option :sls.vns_mc 5)
(set-option :sls.vns_repick true)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(declare-fun z () (_ BitVec 32))
(assert (= (bvmul x y) z))
(assert (bvugt x #x00000100))
(assert (bvugt y #x00000200))
(check-sat)
(get-model)