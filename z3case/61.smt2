(set-option :sat.asymm_branch.limit 90000000)
(set-option :sat.cut.aig true)
(set-option :sat.learned_clauses_ge_fraction 0.7)
(set-option :sat.pb.solver totalizer)
(set-option :sat.subsumption false)
(set-logic QF_S)
(declare-fun s1 () String)
(declare-fun s2 () String)
(assert (str.prefixof s1 s2))
(assert (> (str.len s1) 5))
(assert (str.contains s2 "abc"))
(check-sat)