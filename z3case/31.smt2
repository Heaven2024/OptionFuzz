(set-option :sat.local_search true)
(set-option :sat.local_search_threads 2)
(set-option :sat.lookahead.cube.cutoff adaptive_psat)
(set-option :sat.lookahead.cube.fraction 0.5)
(set-option :sat.lookahead.reward heule_schur)
(set-logic QF_BV)
(declare-fun m () (_ BitVec 8))
(declare-fun n () (_ BitVec 8))
(declare-fun o () (_ BitVec 8))
(assert (= (bvor m n) o))
(assert (bvult m #x80))
(assert (bvugt n #x40))
(assert (bvule o #xC0))
(check-sat)
(get-model)