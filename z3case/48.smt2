(set-option :sat.lookahead.preselect true)
(set-option :sat.lookahead.cube.psat.clause_base 2.5)
(set-option :sat.lookahead.cube.psat.trigger 6.0)
(set-option :sat.max_memory 1000)
(set-logic QF_UF)
(declare-sort S 0)
(declare-fun f (S) S)
(declare-fun a () S)
(assert (not (= (f (f a)) a)))
(check-sat)