(set-option :sat.lookahead.global_autarky false)
(set-option :sat.lookahead.cube.psat.clause_base 3.0)
(set-option :sat.lookahead.cube.psat.var_exp 1.8)
(set-option :sat.gc.burst true)
(set-logic QF_IDL)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (<= (- x y) 5))
(assert (<= (- y z) 3))
(assert (>= (- x z) 9))
(check-sat)