(set-option :sat.branching.anti_exploration true)
(set-option :sat.cardinality.encoding bimander)
(set-option :sat.phase always_true)
(set-option :sat.random_freq 0.02)
(set-option :sat.restart luby)
(set-logic QF_LIA)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (>= (+ x y) 10))
(assert (<= (- x z) 5))
(assert (= (* 2 y) (+ z 3)))
(check-sat)
(get-model)