(set-option :sat.local_search_threads 2)
(set-option :sat.local_search true)
(set-option :sat.random_freq 0.05)
(set-option :sat.restart luby)
(set-logic QF_FP)
(declare-fun x () (_ FloatingPoint 8 24))
(declare-fun y () (_ FloatingPoint 8 24))
(assert (fp.gt x ((_ to_fp 8 24) RNE 0.0)))
(assert (fp.lt y x))
(check-sat)