(set-option :sat.core.minimize_partial true)
(set-option :sat.ddfw.restart_base 120000)
(set-option :sat.local_search_mode qsat)
(set-option :sat.random_freq 0.05)
(set-option :sat.restart.max 5000000)
(set-logic QF_AUFLIA)
(declare-fun a () (Array Int Int))
(declare-fun i () Int)
(declare-fun j () Int)
(assert (= (select a i) (select a j)))
(assert (not (= i j)))
(assert (> (+ i j) 10))
(check-sat)