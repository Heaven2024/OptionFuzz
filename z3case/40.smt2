(set-option :sat.elim_vars_bdd_delay 4)
(set-option :sat.gc.small_lbd 4)
(set-option :sat.lookahead.global_autarky true)
(set-option :sat.pb.lemma_format pb)
(set-option :sat.random_seed 42)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(assert (bvult x #x7FFFFFFF))
(assert (bvugt y #x80000000))
(assert (= (bvand x y) #x00000000))
(assert (= (bvor x y) #xFFFFFFFF))
(check-sat)
(get-model)